# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: bms_sensor
label: bms_sensor
author: Silicon Laboratories, Inc.
description: This is a Zigbee minimal SoC network-layer application suitable as a  starting
  point for new application development.
category: Zigbee Application
filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Advanced]
- name: Wireless Technology
  value: [Zigbee]
package: Zigbee
quality: production
source:
- {path: main.c}
- {path: app.c}
- {path: ../src/app_config.c}
- {path: ../src/app_config.h}
- {path: ../src/settings.c}
- {path: ../src/settings.h}
- {path: ../src/bms_protocol.c}
- {path: ../src/bms_protocol.h}
- {path: ../src/rs485.c}
- {path: ../src/rs485.h}
- {path: ../src/bms_metrics.h}
- {path: ../src/bms_metrics.c}
- {path: ../src/bms_metrics_table.c}
- {path: ../src/zigbee.c}
- {path: ../src/zigbee.h}
- {path: ../src/supply.c}
- {path: ../src/supply.h}
sdk: {id: gecko_sdk, version: 4.5.1}
toolchain_settings: []
component:
- {id: EFR32MG1B232F256GM48}
- {id: emlib_usart}
- {id: zigbee_reporting}
- {id: zigbee_end_device_support}
- {id: zigbee_network_steering}
- {id: zigbee_pro_leaf_stack}
- {id: zigbee_scan_dispatch}
- {id: zigbee_update_tc_link_key}
- {id: zigbee_zcl_framework_core}
config_file:
- {path: config/zcl/zcl_config.zap, directory: zcl}
configuration:
- {name: SL_BOARD_ENABLE_VCOM, value: '1'}
- condition: [iostream_usart]
  name: SL_IOSTREAM_USART_VCOM_FLOW_CONTROL_TYPE
  value: usartHwFlowControlCtsAndRts
- condition: [iostream_eusart]
  name: SL_IOSTREAM_EUSART_VCOM_FLOW_CONTROL_TYPE
  value: eusartHwFlowControlCtsAndRts
- {name: SL_CLI_MAX_INPUT_ARGUMENTS, value: '16'}
- {name: SLI_ZIGBEE_PRIMARY_NETWORK_DEVICE_TYPE, value: SLI_ZIGBEE_NETWORK_DEVICE_TYPE_SLEEPY_END_DEVICE}
- {name: SLI_ZIGBEE_PRIMARY_NETWORK_SECURITY_TYPE, value: SLI_ZIGBEE_NETWORK_SECURITY_TYPE_3_0}
- {name: EMBER_BINDING_TABLE_SIZE, value: '127'}
- condition: [device_series_1]
  name: NVM3_DEFAULT_NVM_SIZE
  value: '36864'
- condition: [device_series_2]
  name: NVM3_DEFAULT_NVM_SIZE
  value: '32768'
- {name: SL_PSA_ITS_SUPPORT_V1_DRIVER, value: '0'}
- {name: SL_PSA_ITS_SUPPORT_V2_DRIVER, value: '0'}
- {name: SL_PSA_ITS_SUPPORT_V3_DRIVER, value: '1'}

- {name: EMBER_AF_PLUGIN_REPORTING_ENABLE_EXPANDED_TABLE, value: '1'}
- {name: EMBER_AF_PLUGIN_REPORTING_EXPANDED_TABLE_SIZE, value: '64'}
- {name: NVM3_DEFAULT_CACHE_SIZE, value: '500'}
- {name: SL_ZIGBEE_APP_FRAMEWORK_STAY_AWAKE_WHEN_NOT_JOINED, value: '0'}
- {name: EMU_CUSTOM_IRQ_HANDLER, value: 'true'}
