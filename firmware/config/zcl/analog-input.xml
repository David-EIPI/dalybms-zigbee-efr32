<?xml version="1.0"?>
<configurator>
  <!-- Standard ZCL Analog Input (Basic), absent from this GSDK's XML catalog. -->
  <cluster>
    <name>Analog Input (Basic)</name>
    <domain>General</domain>
    <description>Read-only physical measurements from the BMS.</description>
    <code>0x000C</code>
    <define>ANALOG_INPUT_BASIC_CLUSTER</define>
    <client tick="false" init="false">true</client>
    <server tick="false" init="false">true</server>
    <globalAttribute side="either" code="0xFFFD" value="1"/>
    <attribute side="server" code="0x001C" define="ANALOG_INPUT_DESCRIPTION" type="CHAR_STRING" length="48" writable="false" default="" optional="true">description</attribute>
    <attribute side="server" code="0x0051" define="ANALOG_INPUT_OUT_OF_SERVICE" type="BOOLEAN" writable="false" default="0" optional="false">out of service</attribute>
    <attribute side="server" code="0x0055" define="ANALOG_INPUT_PRESENT_VALUE" type="FLOAT_SINGLE" writable="false" reportable="true" default="0" optional="false">present value</attribute>
    <attribute side="server" code="0x0067" define="ANALOG_INPUT_RELIABILITY" type="ENUM8" writable="false" default="7" optional="true">reliability</attribute>
    <attribute side="server" code="0x006A" define="ANALOG_INPUT_RESOLUTION" type="FLOAT_SINGLE" writable="false" default="1" optional="true">resolution</attribute>
    <attribute side="server" code="0x006F" define="ANALOG_INPUT_STATUS_FLAGS" type="BITMAP8" writable="false" reportable="true" default="2" optional="false">status flags</attribute>
    <attribute side="server" code="0x0075" define="ANALOG_INPUT_ENGINEERING_UNITS" type="ENUM16" writable="false" default="95" optional="true">engineering units</attribute>
  </cluster>
</configurator>
